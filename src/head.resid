// head.resid — the parts of CBOR that are not the protocol: heads (RFC
// 8949 §3), UTF-8 in both directions, and hex for the debugging surface.
//
// A head is a major type (0..7) in the top three bits of one byte and an
// argument in the rest: directly for 0..23, or as 1, 2, 4 or 8 following
// big-endian bytes for 24, 25, 26 and 27. Additional information 31 means
// "indefinite length" to a container and "break" where an item is expected.
// Encoding always takes the shortest form that holds the argument.

import "../../resid-serial/src/serial.resid";
import "../../resid-serial/src/seq.resid";

// ─── Heads ───────────────────────────────────────────────────────────

// `v` as 16 big-endian bytes, which is where every head's argument is
// read from: the shortest run of them that is not a leading zero is the
// argument.
// Least significant first, then reversed: a builder can only append.
pub List(Int) cb_be16(UInt(128) v) { return cb_rev(cb_be16_at(v, 16, []), 0, []); }

pub List(Int) cb_be16_at(UInt(128) v, Int n, List(Int) acc) {
    if (n == 0) { return acc; }
    UInt(128) q = v / u128(256);
    return cb_be16_at(q, n - 1, acc.concat([(Int)(v - q * u128(256))]));
}

pub List(Int) cb_rev(List(Int) xs, Int i, List(Int) acc) {
    if (i >= xs.len()) { return acc; }
    return cb_rev(xs, i + 1, [xs[i]].concat(acc));
}

// The head for `arg` under `major`. Callers pass an argument that fits in
// 64 bits: a wider one is a CBOR bignum, not a longer head.
pub List(Int) cb_head(Int major, UInt(64) arg) {
    List(Int) full = cb_be16(u128(arg));
    return cb_head_at(full, cb_first_set(full, 0), major);
}

// The first byte that is not a leading zero, which is where the argument
// starts.
pub Int cb_first_set(List(Int) full, Int i) {
    if (i >= full.len() - 1) { return i; }
    if (full[i] == 0) { return cb_first_set(full, i + 1); }
    return i;
}

// The head for an argument of `n` significant bytes: the shortest of the
// five forms, zero-padded on the left to the width it takes.
pub List(Int) cb_head_at(List(Int) full, Int i, Int major) {
    Int n = full.len() - i;
    Int mt = major << 5;
    Int b0 = if (n == 0) { 0 } else { full[i] };
    if (n <= 1 && b0 <= 23) { return [mt | b0]; }
    if (n <= 1) { return [mt | 24, b0]; }
    if (n <= 2) { return [mt | 25, b0, cb_byte_at(full, i + 1)]; }
    if (n <= 4) { return [mt | 26, cb_byte_at(full, full.len() - 4), cb_byte_at(full, full.len() - 3), cb_byte_at(full, full.len() - 2), cb_byte_at(full, full.len() - 1)]; }
    return [mt | 27, cb_byte_at(full, full.len() - 8), cb_byte_at(full, full.len() - 7), cb_byte_at(full, full.len() - 6), cb_byte_at(full, full.len() - 5), cb_byte_at(full, full.len() - 4), cb_byte_at(full, full.len() - 3), cb_byte_at(full, full.len() - 2), cb_byte_at(full, full.len() - 1)];
}

// One byte of the argument, zero past its end (the padding).
pub Int cb_byte_at(List(Int) full, Int i) { return if (i >= full.len()) { 0 } else { full[i] }; }

// A length as the head argument, without an extra paren dance.
pub UInt(64) cb_len(List(Int) xs) { Int n = xs.len(); return (UInt(64))n; }

// A big number: tag 2 (positive) or 3 (negative) around a byte string of
// the magnitude, big-endian, no leading zeros (RFC 8949 §3.4.3).
pub List(Int) cb_bignum(Bool negative, UInt(128) magnitude) {
    List(Int) be = cb_be16(magnitude);
    Int start = cb_leading_zeros(be, 0);
    List(Int) body = be[start..be.len()];
    List(Int) trimmed = if (body.len() == 0) { [0] } else { body };
    Int n = trimmed.len();
    List(Int) tag = cb_head(6, if (negative) { u64(3) } else { u64(2) });
    List(Int) wrap = cb_head(2, (UInt(64))n);
    return tag.concat(wrap).concat(trimmed);
}

pub Int cb_leading_zeros(List(Int) be, Int i) {
    if (i >= be.len() - 1) { return i; }
    if (be[i] == 0) { return cb_leading_zeros(be, i + 1); }
    return i;
}

// ─── UTF-8 ───────────────────────────────────────────────────────────

pub List(Int) cb_cp_bytes(Int cp) {
    Int w = utf8_width(cp);
    if (w == 1) { return [cp]; }
    if (w == 2) { return [192 + (cp >> 6), 128 + (cp & 63)]; }
    if (w == 3) { return [224 + (cp >> 12), 128 + ((cp >> 6) & 63), 128 + (cp & 63)]; }
    return [240 + (cp >> 18), 128 + ((cp >> 12) & 63), 128 + ((cp >> 6) & 63), 128 + (cp & 63)];
}

// A string as the bytes a text string carries.
pub List(Int) cb_str_bytes(Str s) { return cb_str_bytes_at(s, 0, []); }

pub List(Int) cb_str_bytes_at(Str s, Int i, List(Int) acc) {
    if (i >= str_len(s)) { return acc; }
    return cb_str_bytes_at(s, i + 1, acc.concat(cb_cp_bytes(str_char_at(s, i))));
}

// One code point read at `i`, and where the next one starts.
type CbCp = { Int cp; Int next; };

pub Result(CbCp, SerialError) cb_cp_at(List(Int) bs, Int i, Str what) {
    if (i >= bs.len()) { return Err(eof_error(what)); }
    Int b0 = bs[i];
    if (b0 < 128) { return Ok(CbCp {.cp = b0, .next = i + 1}); }
    if (b0 < 192) { return Err(syntax_error(f"invalid UTF-8 in {what}: a continuation byte starts it")); }
    Int extra = if (b0 < 224) { 1 } else { if (b0 < 240) { 2 } else { 3 } };
    if (i + extra >= bs.len()) { return Err(eof_error(what)); }
    Int head = if (extra == 1) { b0 - 192 } else { if (extra == 2) { b0 - 224 } else { b0 - 240 } };
    return cb_cp_cont(bs, i, extra, 0, head, what);
}

pub Result(CbCp, SerialError) cb_cp_cont(List(Int) bs, Int i, Int extra, Int k, Int cp, Str what) {
    if (k >= extra) { return Ok(CbCp {.cp = cp, .next = i + 1 + extra}); }
    Int b = bs[i + 1 + k];
    if (b < 128 || b > 191) { return Err(syntax_error(f"invalid UTF-8 in {what}")); }
    return cb_cp_cont(bs, i, extra, k + 1, (cp << 6) | (b & 63), what);
}

// The bytes at [i, end) as a string.
pub Result(Str, SerialError) cb_str_at(List(Int) bs, Int i, Int end, Str what) { return cb_str_at_buf(bs, i, end, StrBuf(), what); }

pub Result(Str, SerialError) cb_str_at_buf(List(Int) bs, Int i, Int end, StrBuf b, Str what) {
    if (i >= end) { return Ok(b.finish()); }
    Result(CbCp, SerialError) r = cb_cp_at(bs, i, what);
    if (Err(e) = r) { Str dropped = b.finish(); return Err(e); }
    if (Ok(c) = r) { return cb_str_at_buf(bs, c.next, end, b.push_char(c.cp), what); }
    Str dropped2 = b.finish();
    return Err(custom_error("unreachable"));
}

// How many code points the bytes at [i, end) hold, for a stream's count.
pub Result(Int, SerialError) cb_cp_count(List(Int) bs, Int i, Int end, Str what) { return cb_cp_count_at(bs, i, end, 0, what); }

pub Result(Int, SerialError) cb_cp_count_at(List(Int) bs, Int i, Int end, Int acc, Str what) {
    if (i >= end) { return Ok(acc); }
    Result(CbCp, SerialError) r = cb_cp_at(bs, i, what);
    if (Err(e) = r) { return Err(e); }
    if (Ok(c) = r) { return cb_cp_count_at(bs, c.next, end, acc + 1, what); }
    return Err(custom_error("unreachable"));
}

// ─── Hex ─────────────────────────────────────────────────────────────

pub Str cb_hex_digit(Int n) { return str_slice("0123456789abcdef", n, n + 1); }

pub Str cb_hex(List(Int) bs) { return cb_hex_at(bs, 0, StrBuf()); }

// The hex text, two digits per byte, gathered in one builder.
pub Str cb_hex_at(List(Int) bs, Int i, StrBuf b) {
    if (i >= bs.len()) { return b.finish(); }
    StrBuf more = b.push(cb_hex_digit(bs[i] >> 4)).push(cb_hex_digit(bs[i] & 15));
    return cb_hex_at(bs, i + 1, more);
}

pub Result(List(Int), SerialError) cb_unhex(Str h) { return cb_unhex_at(h, 0, ListBuf()); }

pub Result(List(Int), SerialError) cb_unhex_at(Str h, Int i, ListBuf(Int) b) {
    if (i >= str_len(h)) { return Ok(b.finish()); }
    Int hi = cb_hex_nibble(h, i);
    if (hi < 0) { List(Int) dropped = b.finish(); return Err(syntax_error(f"invalid hex digit in \"{h}\"")); }
    Int lo = cb_hex_nibble(h, i + 1);
    if (lo < 0) { List(Int) dropped2 = b.finish(); return Err(syntax_error(f"invalid hex digit in \"{h}\"")); }
    return cb_unhex_at(h, i + 2, b.push(hi * 16 + lo));
}

pub Int cb_hex_nibble(Str h, Int i) {
    if (i >= str_len(h)) { return -1; }
    Int c = str_char_at(h, i);
    if (c >= 48 && c <= 57) { return c - 48; }
    if (c >= 97 && c <= 102) { return c - 87; }
    if (c >= 65 && c <= 70) { return c - 55; }
    return -1;
}